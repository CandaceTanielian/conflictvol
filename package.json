{
  "name": "conflictvol",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:demo": "cross-env EXPO_PUBLIC_DEMO=true expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "cross-env APP_VARIANT=development expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:demo": "cross-env EXPO_PUBLIC_DEMO=true expo export --platform web",
    "predeploy": "cross-env EXPO_PUBLIC_DEMO=true expo export --platform web && node scripts/prepare-pages.mjs",
    "deploy": "gh-pages --nojekyll -d deploy-dist",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~55.0.0",
    "d3-geo": "^3.1.1",
    "expo": "55",
    "expo-dev-client": "~55.0.28",
    "expo-font": "^55.0.6",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "^0.83.6",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "~19.2.2",
    "@types/topojson-client": "^3.1.5",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  }
}
